nick: globalnick
user: globaluser
realname: Global Real Name

previews:
  enabled: true
  max_bytes: 524288        # 512 KiB cap per HTTP fetch
  timeout_ms: 5000
  cache_ttl_hours: 168     # 1 week
  workers: 4

# Image upload storage. Omit this block entirely to disable uploads; if it is
# present the backend must be named and complete, or the process refuses to
# start. There is no fallback between backends.
# Provisioning walkthrough for the s3 backend: see S3_SETUP.md.
media:
  backend: s3              # "s3" | "disk"
  max_bytes: 20971520      # 20 MiB per upload (optional)
  s3:
    endpoint: s3.eu-north-1.amazonaws.com      # no scheme
    region: eu-north-1
    bucket: lurker-media
    access_key_id: ${AWS_ACCESS_KEY_ID_LURKER}
    secret_access_key: ${AWS_SECRET_ACCESS_KEY_LURKER}
    public_base_url: https://cdn.example.com   # CloudFront domain, not the S3 host
    prefix: ""                                 # optional key prefix inside the bucket
    path_style: false                          # true for MinIO / B2-style endpoints
  # The disk backend is a peer of s3, not a fallback — it serves uploads from
  # this host, so the URLs only resolve for clients that can reach it.
  # disk:
  #   dir: ./data/uploads
  #   base_url: ""         # optional; empty derives the URL from the request

networks:
  - network: Ircnet
    nick: mynick
    user: myuser
    realname: My Real Name
    channels:
      - "#test"
      - "#golang"
    sasl_user: mynick
    sasl_pass: secret
    connect_commands:
      - "PRIVMSG NickServ :IDENTIFY secret"
      - "MODE mynick +x"
    servers:
      - host: irc.ircnet.com
        port: 6697
        tls: true
        # Optional: cap TLS when a server is known to be picky. By default Lurker tries Go's default TLS first, then retries TLS 1.2 with legacy RSA AES-GCM ciphers on connect error.
        # tls_max_version: "1.2"
      - host: open.ircnet.net
        port: 6697
        tls: true

# Non-IRC data sources. Each entry becomes a separate "network" in the UI.
# Read-only; mutating commands against these buffers are rejected server-side.
data_sources:
  bluesky:
    - network: bluesky
      identifier: alice.bsky.social
      app_password: ${BLUESKY_APP_PASSWORD}   # ${VAR} is expanded from env
      pds: https://bsky.social                # optional; default shown
      # Channels list is optional. If omitted, an implicit
      # `kind: timeline` channel named "<handle>-feed" is created.
      channels:
        - kind: timeline
