nick: globalnick
user: globaluser
realname: Global Real Name

previews:
  enabled: true
  max_bytes: 524288        # 512 KiB cap per HTTP fetch
  timeout_ms: 5000
  cache_ttl_hours: 168     # 1 week
  workers: 4

networks:
  - network: Ircnet
    nick: mynick
    user: myuser
    realname: My Real Name
    channels:
      - "#test"
      - "#golang"
    sasl_user: mynick
    sasl_pass: secret
    connect_commands:
      - "PRIVMSG NickServ :IDENTIFY secret"
      - "MODE mynick +x"
    servers:
      - host: irc.ircnet.com
        port: 6697
        tls: true
        # Optional: cap TLS when a server is known to be picky. By default Lurker tries Go's default TLS first, then retries TLS 1.2 with legacy RSA AES-GCM ciphers on connect error.
        # tls_max_version: "1.2"
      - host: open.ircnet.net
        port: 6697
        tls: true
