    subgraph preview_youtube_go["preview/youtube.go"]
        preview_youtube_go_isyoutube["IsYouTube<br/>in:1 out:0"]
        preview_youtube_go_fetchyoutube["fetchYouTube<br/>in:1 out:0"]
    end
    media_browse_go_existsmedia --> db_media_store_go_getbysourcehash
    media_browse_go_existsmedia --> media_upload_go_writeuploadresponse
    media_browse_go_listmedia --> db_media_store_go_list
    media_browse_go_listmedia --> media_upload_go_uploadurl
    media_upload_go_allocateandstore --> db_media_store_go_insert
    media_upload_go_upload --> db_media_store_go_getbysourcehash
    media_upload_go_upload --> media_transcode_go_classifymedia
    media_upload_go_upload --> media_transcode_go_optimizeimage
    preview_dialer_go_pinningdialcontext --> preview_ssrf_go_ipallowed
    preview_fetcher_go_fetch --> db_time_go_now
    preview_fetcher_go_newfetcher --> preview_dialer_go_pinningtransport
    preview_fetcher_go_newfetcher --> preview_ssrf_go_checkurl
    preview_fetcher_go_classifyhead --> db_time_go_now
    preview_fetcher_go_enrichfromactivitypub --> preview_fediverse_go_fetchactivitypub
    preview_fetcher_go_tryyoutube --> preview_youtube_go_isyoutube
    preview_fetcher_go_tryyoutube --> preview_youtube_go_fetchyoutube
    preview_image_go_fetchimage --> preview_fetcher_go_contenttype
    preview_image_go_fetchimage --> preview_fetcher_go_dorequest
    preview_service_go_newservice --> preview_fetcher_go_newfetcher
    preview_service_go_process --> db_logstore_go_insertmessagepreviewlinks
    preview_service_go_process --> db_multistore_go_logstore
    preview_service_go_process --> db_preview_store_go_displayable
    preview_service_go_process --> hub_hub_go_publish
    preview_service_go_process --> preview_extract_go_extracturls
    preview_service_go_process --> preview_fetcher_go_fetch

    media_browse_go_existsmedia:::orphan
    media_browse_go_listmedia:::orphan
    media_upload_go_allocateandstore:::orphan
    media_upload_go_upload:::orphan
    preview_dialer_go_pinningdialcontext:::orphan
    preview_fetcher_go_newfetcher:::hot
    preview_fetcher_go_classifyhead:::orphan
    preview_fetcher_go_enrichfromactivitypub:::orphan
    preview_fetcher_go_tryyoutube:::orphan
    preview_image_go_fetchimage:::orphan
    preview_service_go_newservice:::entry
    preview_service_go_process:::orphan

    classDef hot fill:#b23a3a,stroke:#7a1f1f,color:#ffffff
    classDef orphan fill:#6b6b6b,stroke:#3f3f3f,color:#ffffff
