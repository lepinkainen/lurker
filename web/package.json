{
  "name": "lurker-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "biome check src tests && stylelint \"src/**/*.css\"",
    "lint:fix": "biome check --write src tests && stylelint \"src/**/*.css\" --fix",
    "format": "biome format --write src tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@vitest/browser-playwright": "^5.0.2",
    "jsdom": "30.1.1",
    "mermaid": "12.0.0",
    "playwright": "^1.63.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
