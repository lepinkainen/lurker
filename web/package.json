{
  "name": "lurker-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "biome check src tests && stylelint \"src/**/*.css\"",
    "lint:fix": "biome check --write src tests && stylelint \"src/**/*.css\" --fix",
    "format": "biome format --write src tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@vitest/browser-playwright": "^5.0.5",
    "jsdom": "30.1.3",
    "mermaid": "12.2.0",
    "playwright": "^1.64.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
